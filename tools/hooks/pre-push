#!/usr/bin/env sh
# Read the outgoing refs from Git's standard input. Missing tools block the push.
set -eu
ROOT="$(git rev-parse --show-toplevel)" || exit 1
GATE="$ROOT/tools/git_upload_gate.py"
if [ ! -f "$GATE" ]; then
    echo '[upload-gate] checker_missing' >&2
    exit 1
fi
if [ -n "${OPL_PYTHON:-}" ]; then
    PY="$OPL_PYTHON"
elif [ -n "${SELFVO_PYTHON:-}" ]; then
    PY="$SELFVO_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo '[upload-gate] python_missing' >&2
    exit 1
fi
exec "$PY" "$GATE" --repo "$ROOT" --pre-push --require-signed-main

#!/bin/sh
# pre-commit —— OpenPlanLink mirror 提交前校验（"提交即验证"）。
# 安装：cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 校验：① 暂存区 .py 逐个编译 ② 核心测试套件（TOTP + HMAC 包络）。

set -e

ROOT="$(git rev-parse --show-toplevel)"
PY="${PYTHON:-python}"
FAIL=0
CHECK_TMP=$(mktemp -d "${TMPDIR:-${TEMP:-/tmp}}/opl-precommit.XXXXXX")
trap 'rm -rf -- "$CHECK_TMP"' EXIT HUP INT TERM

# ① 暂存区 Python 编译检查
staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$staged_py" ]; then
  echo "[pre-commit] 编译检查暂存区 Python："
  for f in $staged_py; do
    if [ -f "$ROOT/$f" ]; then
      if ! "$PY" -m py_compile "$ROOT/$f" 2>"$CHECK_TMP/compile_err"; then
        echo "  ✗ $f 编译失败："
        cat "$CHECK_TMP/compile_err"
        FAIL=1
      else
        echo "  ✓ $f"
      fi
    fi
  done
else
  echo "[pre-commit] 无暂存区 Python 文件，跳过编译。"
fi

# ② 核心测试套件
echo "[pre-commit] 跑核心测试："
for t in tools/test_totp.py tools/test_a2a_hmac.py; do
  if [ -f "$ROOT/$t" ]; then
    if ! "$PY" "$ROOT/$t" >"$CHECK_TMP/test_out" 2>&1; then
      echo "  ✗ $t 失败："
      tail -n 5 "$CHECK_TMP/test_out"
      FAIL=1
    else
      echo "  ✓ $t"
    fi
  fi
done

if [ "$FAIL" -ne 0 ]; then
  echo "[pre-commit] 校验未通过，已阻止提交。"
  exit 1
fi
echo "[pre-commit] 校验通过。"
exit 0

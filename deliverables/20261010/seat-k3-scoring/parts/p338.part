  scene.add(NEBULA); // 远端语义：缩到最远，星云穹顶完全显影
  const cam=new THREE.PerspectiveCamera(55,W/H,.1,200);cam.position.set(0,6,26);
  const ren=new THREE.WebGLRenderer({antialias:true,alpha:true});ren.setSize(W,H);ren.setPixelRatio(Math.min(devicePixelRatio,2));
  holder.appendChild(ren.domElement);
  const sg=new THREE.BufferGeometry(),sp=[];
  for(let i=0;i<600;i++)sp.push((Math.random()-.5)*160,Math.random()*80-10,-Math.random()*80);
  sg.setAttribute('position',new THREE.Float32BufferAttribute(sp,3));
  scene.add(new THREE.Points(sg,new THREE.PointsMaterial({color:0xaaccff,size:.18,transparent:true,opacity:.8})));
  const grid=new THREE.GridHelper(120,60,0x1c2650,0x141c3a);grid.position.y=-4;scene.add(grid);
  const wheel=new THREE.Group();
  wheel.add(new THREE.Mesh(new THREE.TorusGeometry(8,.09,8,64),new THREE.MeshBasicM
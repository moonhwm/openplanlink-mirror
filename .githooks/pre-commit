#!/bin/sh
# 守藏席 2026-10-03/04 部署：预提交门禁（凭据泄露扫描）
# v3：修正 git grep 选项顺序（--cached 须在 -n 前），stderr 不再静默吞掉
set -e
CRED_PATTERNS='BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY|password[[:space:]]*=[[:space:]]*"[^"]+"|api[_-]?key[[:space:]]*=[[:space:]]*"[^"]+"|sk-[A-Za-z0-9]{20,}'
HITS=$(git grep --cached -I -n -E "$CRED_PATTERNS" -- ':!.githooks/' | head -5)
if [ -n "$HITS" ]; then
  echo "[hook:pre-commit] 阻断：暂存区检出疑似凭据模式（见即止不外显）" >&2
  . "$(git rev-parse --git-path hooks)/pre-commit-fail-alert" "credential-scan"
  exit 1
fi
exit 0

#!/bin/sh
# 守藏席 2026-10-03 部署：推送审计日志（事件驱动·异常处理与补偿机制）
AUDIT_LOG="$HOME/.githooks-audit.log"
while read -r local_ref local_oid remote_ref remote_oid; do
  echo "$(date '+%Y-%m-%d %H:%M:%S') [post-push] $local_ref ${local_oid:0:12} -> $remote_ref ${remote_oid:0:12} result=OK" >> "$AUDIT_LOG"
done
exit 0
